# Copy this file to .env and fill in the keys. Every setting lives here, nothing is hardcoded.

# ------------------------------------------------------------------ server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------ API keys
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------ Google Calendar
# The calendar ID: "primary" or the long id from Calendar settings (Integrate calendar).
GOOGLE_CALENDAR_ID=
# A short-lived (about 1 hour) access token pasted by hand. See the README.
GOOGLE_CALENDAR_API_TOKEN=
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
CALENDAR_TIMEOUT_SECONDS=4
CALENDAR_MAX_RETRIES=1
# Repeated "what is free on that day" questions are answered from memory for this long.
CALENDAR_CACHE_SECONDS=20
CALENDAR_KEEPALIVE_EXPIRY_SECONDS=120
CALENDAR_WARM_INTERVAL_SECONDS=25

# ------------------------------------------------------------------ the business
BUSINESS_NAME=Northlight Consulting
BUSINESS_STAFF_NAME=Ayesha Khan
BUSINESS_TIMEZONE=Asia/Karachi
# Format: days hours;days hours   (days: mon tue wed thu fri sat sun, or a range like mon-fri)
BUSINESS_HOURS=mon-fri 09:00-17:00;sat 10:00-14:00
# Daily breaks, comma separated. Use "none" for no break.
BUSINESS_BREAKS=13:00-14:00
SERVICES_FILE=data/services.json
BOOKING_BUFFER_MINUTES=10
MIN_NOTICE_MINUTES=60
MAX_ADVANCE_DAYS=30
SLOT_STEP_MINUTES=30
MAX_SLOTS_RETURNED=4
MAX_SEARCH_DAYS=7
CANCELLATION_NOTICE_HOURS=24
BOOKING_REF_DIGITS=6
# Wrong booking reference or phone number attempts allowed per conversation.
MAX_VERIFY_FAILURES=3
# After that many wrong tries for one phone number, lookups for that number are locked for this long (all callers).
VERIFY_LOCK_SECONDS=600
# Two callers may be preparing the same slot at once. A change made by this server this recently blocks the slower one.
WRITE_RACE_WINDOW_SECONDS=30

# ------------------------------------------------------------------ OpenAI (LLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=200
OPENAI_KEEPALIVE_EXPIRY_SECONDS=120
OPENAI_WARM_INTERVAL_SECONDS=20
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
# How many past messages the assistant remembers during one conversation.
HISTORY_MAX_MESSAGES=20
# The assistant may call tools up to this many times for one answer.
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_SECONDS=10
AGENT_FALLBACK_REPLY="Sorry, I am having trouble with that. Could you say it again?"

# ------------------------------------------------------------------ confirmation before any change
# A booking, change or cancellation only happens after the caller says one of these words.
CONFIRM_WORDS="yes,yeah,yep,yup,sure,correct,confirm,confirmed,absolutely,definitely,okay,ok,go ahead,do it,please do"
# If the answer also contains one of these, it does not count as a yes.
REFUSE_WORDS="no,nope,not,dont,don't,wait,stop,hold on,never"
CONFIRM_TTL_SECONDS=180

# ------------------------------------------------------------------ spoken while a tool works
# Several phrases are separated with | and used in turn.
TOOL_FILLER_READ="Let me check that.|One moment.|Sure, one second."
TOOL_FILLER_WRITE="Okay, doing that now.|One moment while I do that."
# A change that only needs a confirmation question finishes at once; the filler is only said if it takes longer than this.
TOOL_FILLER_WRITE_DELAY_SECONDS=0.2

# ------------------------------------------------------------------ guardrails
INPUT_MAX_CHARS=500
# Phrases that are never passed to the model. Regular expressions, separated with ;; (case does not matter).
INPUT_BLOCK_PATTERNS='(ignore|disregard|forget) (all |any |the |your |previous |prior |above |earlier )*(instructions|rules|prompts?);;(reveal|show|tell|repeat|print|read) (me )?(your|the) (system |hidden |initial |secret )?(prompt|instructions|rules);;\byou are now\b;;\bact as (a|an|the) (different|new|unrestricted|another);;\bpretend (to be|you are|you.re)\b;;\bdeveloper mode\b;;\bjailbreak\b;;\boverride (your|the) (rules|instructions|safety);;\b(api|access|auth) ?(key|token)\b'
INPUT_BLOCK_REPLY="Sorry, I can only help with appointments. Would you like to book, change or cancel one?"
INPUT_TOO_LONG_REPLY="Sorry, that was a lot to take in. Could you say it again in a shorter way?"
OUTPUT_BLOCK_REPLY="Sorry, I cannot say that. Let me help you with your appointment instead."
OUTPUT_UNCONFIRMED_REPLY="Sorry, I have not been able to confirm that with the calendar. Let me check again."

# ------------------------------------------------------------------ Deepgram (STT, Flux)
DEEPGRAM_WS_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_EOT_THRESHOLD=0.7
# Empty = the early draft is switched off.
DEEPGRAM_EAGER_EOT_THRESHOLD=0.4
DEEPGRAM_EOT_TIMEOUT_MS=6000

# ------------------------------------------------------------------ ElevenLabs (TTS)
ELEVENLABS_WS_BASE_URL=wss://api.elevenlabs.io
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_INACTIVITY_TIMEOUT=180
ELEVENLABS_CHUNK_SCHEDULE=50,80,120,160
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_AUTO_MODE=false
TTS_CONNECT_TIMEOUT_SECONDS=15
TURN_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ text chunking and browser audio
FIRST_CHUNK_CHARS=28
CHUNK_TARGET_CHARS=50
CHUNK_MAX_EXTRA_CHARS=6
MIC_CHUNK_MS=80

# ------------------------------------------------------------------ behaviour
BARGE_IN_ENABLED=true
IDLE_TIMEOUT_SECONDS=180
DRAIN_GRACE_SECONDS=3